# Copie este arquivo para .env (na raiz do projeto) e preencha.
# O .env é lido pelo servidor em runtime e NUNCA é commitado (.gitignore).
# Variáveis de ambiente reais têm prioridade sobre o arquivo.

# Senha de acesso ao dashboard /admin (obrigatória para o /admin funcionar)
ADMIN_TOKEN=

# Opcional: onde gravar o log de eventos do funil (default: ./data)
# DATA_DIR=/caminho/absoluto
